2026-11-16 16:28:43.248 UTC [1250] STATEMENT:  CREATE VIEW observation_attribution AS
	SELECT o.observation_id,
	       o.station_id,
	       o.observed_at,
	       o.value,
	       p.period_id,
	       p.watershed,
	       p.valid_from AS period_valid_from,
